# macOS / Windows
.DS_Store
Thumbs.db
Desktop.ini

# --- ESP-IDF (idf.py fetch on build from main/idf_component.yml) ---
managed_components/
build/
firmware/**/.cache/
sdkconfig.old
# Generated per-machine from sdkconfig.defaults; do not commit.
firmware/esp32s3-dongle/sdkconfig

# --- Local ESP-IDF SDK installed by setup.sh ---
/.esp-idf/

# --- PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/
.clang_complete

# --- MicroPython robot firmware image (download per micropython/README.md) ---
firmware/esp32-robot/micropython/*.bin

# --- Python (scripts, automation) ---
__pycache__/
*.py[cod]
$py.class
.venv/
venv/
# Private virtualenv the flash-robot scripts create for esptool + mpremote.
.venv-flash/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Firebase Hosting (web/) deploy cache ---
.firebase/

# --- Node / web tooling (if used) ---
node_modules/
dist/
.pnpm-store/
npm-debug.log*
yarn-error.log
pnpm-debug.log
*.tsbuildinfo

# --- Rust (if used) ---
**/target/

# --- IDEs and editors ---
.idea/
*.swp
*.swo
*~

# --- Debug / local ---
.gdb_history

# --- Local env (never commit) ---
.env
.env.local
.env.*.local
